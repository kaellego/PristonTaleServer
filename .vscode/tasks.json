{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar PristonTaleServer (Debug x64)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1",
                "-Configuration",
                "Debug",
                "-Platform",
                "x64"
            ],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Compilar PristonTaleServer (Release x64)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1",
                "-Configuration",
                "Release",
                "-Platform",
                "x64"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
